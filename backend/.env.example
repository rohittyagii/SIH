# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker (dev):
DATABASE_URL=postgresql+asyncpg://postgres.dtadllzrlvxfrnqjvpnt:joxwez-2xuhte-bYffib@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Cloud (Supabase / Neon — fill in after setup):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Cloud (Upstash free tier):
# REDIS_URL=rediss://<user>:<password>@<host>:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ── Encryption (AES-256 for notes and PII) ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_MASTER_KEY=CHANGE_ME_generate_a_32_byte_hex_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:19006

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
